{
  "name": "timecop",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Display information about where time is spent while Lumine loads.",
  "keywords": [
    "startup",
    "performance",
    "profiler",
    "loading",
    "benchmark"
  ],
  "repository": "https://github.com/lumine-code/timecop",
  "bugs": {
    "url": "https://github.com/lumine-code/timecop/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "lib",
    "menus",
    "spec",
    "styles",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "deserializers": {
    "TimecopView": "createTimecopView"
  },
  "dependencies": {
    "@lumine-code/etch": "github:lumine-code/etch#9f76bc0b47e49e645c25545d78ef439da3e081ee",
    "@lumine-code/underscore-plus": "github:lumine-code/underscore-plus#946eea9f7f3eeed20da34a8606c6e4ba1afcbdc1",
    "dedent": "^1.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  },
  "overrides": {
    "eslint@^10.14.0": {
      "minimatch": "11.0.5"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.5"
    }
  }
}
