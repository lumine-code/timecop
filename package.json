{
  "name": "timecop",
  "author": "lumine-code",
  "version": "1.0.0",
  "description": "Display information about where time is spent while Lumine loads.",
  "keywords": [
    "startup",
    "performance",
    "profiler",
    "loading",
    "benchmark"
  ],
  "repository": "https://github.com/lumine-code/timecop",
  "bugs": {
    "url": "https://github.com/lumine-code/timecop/issues"
  },
  "license": "MIT",
  "main": "./lib/main",
  "files": [
    "lib",
    "menus",
    "spec",
    "styles",
    "THIRD_PARTY_NOTICES"
  ],
  "engines": {
    "lumine": "^1.0.0"
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "deserializers": {
    "TimecopView": "createTimecopView"
  },
  "dependencies": {
    "@lumine-code/etch": "github:lumine-code/etch#c4f4a97341a0a99a0649135be00df09c887e7804",
    "@lumine-code/underscore-plus": "github:lumine-code/underscore-plus#649efa71eda93df22e2e5cb61a22d65fb17654b1",
    "dedent": "^1.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
